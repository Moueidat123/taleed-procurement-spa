{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext", "moduleResolution": "Bundler", "jsx": "react-jsx",
    "strict": true, "noUnusedLocals": true, "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true, "noUncheckedIndexedAccess": true,
    "resolveJsonModule": true, "esModuleInterop": true, "skipLibCheck": true,
    "allowImportingTsExtensions": false, "isolatedModules": true, "noEmit": true,
    "types": ["vite/client"]
  },
  "include": ["src", "vite.config.ts", "playwright.config.ts", "tests/e2e"]
}
