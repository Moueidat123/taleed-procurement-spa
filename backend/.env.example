# Taleed Procurement backend — LOCAL DOCKER template.
# `ops/local/dev init` creates backend/.env from this file, fills __GENERATED__
# values from infra/local/.env and generates a local APP_KEY. Production uses a
# separately provisioned env (Phase 4/5); never copy local values there.

APP_NAME="Taleed Procurement"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://procurement.taleed.test
APP_RELEASE=local

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# Runtime account: data privileges only.
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=procurement
DB_USERNAME=procurement_app
DB_PASSWORD=__GENERATED__
# Schema changes only (php artisan migrate --database=mysql_migrator).
DB_MIGRATOR_USERNAME=procurement_migrator
DB_MIGRATOR_PASSWORD=__GENERATED__

# Same-origin SPA session (host-only cookie, HTTPS only).
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_COOKIE=taleed_procurement_session
SANCTUM_STATEFUL_DOMAINS=procurement.taleed.test
# FastCGI from the local edge: no forwarded headers to trust.
TRUSTED_PROXIES=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# Local mail catcher only (http://127.0.0.1:8025). Not a production provider.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@procurement.taleed.test"
MAIL_FROM_NAME="${APP_NAME}"

# Statamic Core only (decisions.md D-01). No license key, no Pro, no headless APIs.
STATAMIC_LICENSE_KEY=
STATAMIC_PRO_ENABLED=false
STATAMIC_STACHE_WATCHER=auto
STATAMIC_STATIC_CACHING_STRATEGY=null
STATAMIC_TWO_FACTOR_ENABLED=true
STATAMIC_REVISIONS_ENABLED=false
STATAMIC_GRAPHQL_ENABLED=false
STATAMIC_API_ENABLED=false
STATAMIC_GIT_ENABLED=false
STATAMIC_IMPERSONATE_ENABLED=false
# Empty = backend/users (gitignored runtime state).
STATAMIC_USERS_DIRECTORY=
