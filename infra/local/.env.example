# Local Docker settings. `ops/local/dev init` copies this to infra/local/.env
# and replaces every __GENERATED__ value with a random local-only secret.
# Never put production values here.

COMPOSE_PROJECT_NAME=taleed-procurement-dev
PROCUREMENT_HOSTNAME=procurement.taleed.test
PROCUREMENT_HTTPS_PORT=443
PROCUREMENT_HTTP_PORT=80
PROCUREMENT_MAILPIT_PORT=8025
# dev = Vite HMR behind the HTTPS proxy; built = compiled SPA served by Laravel
PROCUREMENT_SPA_MODE=dev

PROCUREMENT_DB=procurement
MYSQL_ROOT_PASSWORD=__GENERATED__
PROCUREMENT_APP_PASSWORD=__GENERATED__
PROCUREMENT_MIGRATOR_PASSWORD=__GENERATED__
PROCUREMENT_TEST_PASSWORD=__GENERATED__
