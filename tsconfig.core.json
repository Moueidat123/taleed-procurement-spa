{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022", "DOM"], "module": "CommonJS",
    "moduleResolution": "Node", "strict": true, "noUncheckedIndexedAccess": true,
    "resolveJsonModule": true, "esModuleInterop": true, "skipLibCheck": true,
    "outDir": ".core", "rootDir": "src", "types": []
  },
  "include": ["src/domain/**/*.ts", "src/data/framework.json", "src/infrastructure/localRepository.ts"]
}
